# SMTP Configuration for Production & Local Contact Form
# Copy this file to .env.local and fill in your actual credentials.

# SMTP Host (e.g. smtp.gmail.com for Gmail, smtp.resend.com for Resend, smtp.brevo.com for Brevo)
SMTP_HOST=smtp.gmail.com

# SMTP Port (587 for TLS, 465 for SSL)
SMTP_PORT=587

# Your SMTP Username (e.g. your-email@gmail.com)
SMTP_USER=ridhorevaldysaputra@gmail.com

# Your SMTP Password (For Gmail, generate an "App Password" at: https://myaccount.google.com/apppasswords)
SMTP_PASS=your_app_password_here

# Destination Email where contact form inquiries will be delivered
CONTACT_RECEIVER=ridhorevaldysaputra@gmail.com
